<!DOCTYPE html>
<html>
  <head>
    <title>New Message</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <main>
      <h1>Create New Message</h1>

      <% if (errors.length > 0) { %>
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      <% } %>

      <form method="POST" action="/new">
        <label>Name</label>

        <input
          type="text"
          name="messageUser"
          value="<%= values.messageUser || '' %>"
        />

        <br><br>

        <label>Message</label>

        <textarea
          name="messageText"
          rows="5"
        ><%= values.messageText || '' %></textarea>

        <br><br>

        <button type="submit">Submit</button>
      </form>

      <br />

      <a href="/"> Back </a>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>
